{
    "name": "muqsit/simple-packet-handler",
    "description": "Handle specific Axolotl-PM data packets",
    "type": "library",
    "license": "GPL-3.0",
    "require": {
        "php": "^8.1",
        "pocketmine/pocketmine-mp": "^5.0.0"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": ["src"]
    },
    "authors": [
        {
            "name": "Muqsit",
            "email": "hackhack05@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --level=max --no-progress"
    },
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "muqsit\\simplepackethandler"
        }
    }
}
